<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane fx:id="rootPane" prefHeight="800" prefWidth="1400" styleClass="root-pane" stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.pollutiontracker.HomePageController">


    <HBox alignment="CENTER_LEFT" prefHeight="65" spacing="20" styleClass="top-bar"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <VBox alignment="CENTER_LEFT" spacing="2" style="-fx-padding: 0 0 0 30;">
            <Label fx:id="cityLabel" styleClass="city-label" text="City" />
            <Label styleClass="sub-label" text="Bangladesh" />
        </VBox>

        <Region HBox.hgrow="ALWAYS" />

        <Label fx:id="dateLabel" styleClass="date-label" text="Monday, 10 Feb 2026" />


<!--        <Button text="Dashboard" onAction="#handleHome" styleClass="nav-btn" />-->
        <Button text="Health Message" onAction="#handleMessage" styleClass="nav-btn" />
        <Button text="Tree Estimation" onAction="#handleTreeEstimation" styleClass="nav-btn" />
        <Button text="Profile" onAction="#handleProfile" styleClass="nav-btn" />

        <Region style="-fx-min-width: 30;" />
    </HBox>


    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="main-scroll"
                AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
                AnchorPane.rightAnchor="0" AnchorPane.topAnchor="65">

        <VBox spacing="25" style="-fx-padding: 25 40;">


            <HBox spacing="25">


                <VBox spacing="12" styleClass="card-box" HBox.hgrow="ALWAYS">

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label styleClass="section-title" text="7 Day Air Quality Forecast" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label styleClass="today-badge" text="THIS WEEK" />
                    </HBox>

                    <BarChart fx:id="weeklyChart" animated="false" barGap="2" categoryGap="30"
                              horizontalGridLinesVisible="false" legendVisible="false"
                              prefHeight="280" verticalGridLinesVisible="false">
                        <xAxis>
                            <CategoryAxis label="" fx:id="xAxis" />
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="yAxis" autoRanging="false" label=""
                                        lowerBound="0" tickUnit="50" upperBound="300" />
                        </yAxis>
                    </BarChart>
                </VBox>


                <VBox alignment="CENTER" prefWidth="320" spacing="10" styleClass="aqi-card">

                    <Label styleClass="aqi-small-label" text="TODAY'S" />
                    <Label styleClass="aqi-title" text="AQI" />

                    <Label fx:id="aqiValueLabel" styleClass="aqi-value" text="200" />

                    <Label prefHeight="4" prefWidth="80" styleClass="aqi-divider" />

                    <Label fx:id="aqiStatusLabel" styleClass="aqi-status" text="Air Quality is Poor" />

                    <HBox alignment="CENTER" spacing="8" style="-fx-padding: 10 0 0 0;">
                        <Label styleClass="aqi-tag-red" text=" Unhealthy" />
                    </HBox>
                </VBox>
            </HBox>


            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label styleClass="section-title" text="Pollutant Levels" />
                <Region HBox.hgrow="ALWAYS" />
            </HBox>


            <HBox spacing="20">

                <!-- CO2 -->
                <VBox alignment="CENTER" spacing="8" styleClass="gas-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="gas-icon-purple" text="CO₂" />
                    <Label styleClass="gas-name" text="Carbon Dioxide" />
                    <Label prefHeight="3" prefWidth="50" styleClass="divider-purple" />
                    <HBox alignment="CENTER" spacing="5">
                        <Label fx:id="co2Label" styleClass="gas-value" text="130" />
                        <Label styleClass="gas-unit" text="PPM" />
                    </HBox>
                    <Label styleClass="gas-status-yellow" text=" Moderate" />
                </VBox>

                <!-- NO2 -->
                <VBox alignment="CENTER" spacing="8" styleClass="gas-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="gas-icon-pink" text="NO₂" />
                    <Label styleClass="gas-name" text="Nitrogen Dioxide" />
                    <Label prefHeight="3" prefWidth="50" styleClass="divider-pink" />
                    <HBox alignment="CENTER" spacing="5">
                        <Label fx:id="no2Label" styleClass="gas-value" text="120" />
                        <Label styleClass="gas-unit" text="PPM" />
                    </HBox>
                    <Label styleClass="gas-status-yellow" text="Moderate" />
                </VBox>

                <!-- NH3 -->
                <VBox alignment="CENTER" spacing="8" styleClass="gas-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="gas-icon-purple" text="NH₃" />
                    <Label styleClass="gas-name" text="Ammonia" />
                    <Label prefHeight="3" prefWidth="50" styleClass="divider-purple" />
                    <HBox alignment="CENTER" spacing="5">
                        <Label fx:id="nh3Label" styleClass="gas-value" text="12" />
                        <Label styleClass="gas-unit" text="PPM" />
                    </HBox>
                    <Label styleClass="gas-status-green" text="Good" />
                </VBox>

                <!-- SO2 -->
                <VBox alignment="CENTER" spacing="8" styleClass="gas-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="gas-icon-pink" text="SO₂" />
                    <Label styleClass="gas-name" text="Sulfur Dioxide" />
                    <Label prefHeight="3" prefWidth="50" styleClass="divider-pink" />
                    <HBox alignment="CENTER" spacing="5">
                        <Label fx:id="so2Label" styleClass="gas-value" text="10" />
                        <Label styleClass="gas-unit" text="PPM" />
                    </HBox>
                    <Label styleClass="gas-status-green" text="Good" />
                </VBox>

            </HBox>


            <Region prefHeight="20" />

        </VBox>
    </ScrollPane>

</AnchorPane>